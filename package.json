    "fp-ts": "^2.16.0",
    "highlight.js": "^11.12.0",
    "io-ts": "^2.2.21",
    "io-ts-types": "^0.5.19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-tea-cup": "5.1.3",
